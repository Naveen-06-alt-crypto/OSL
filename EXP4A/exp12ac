#include <stdio.h>

int main()
{
    // Page reference string
    int ref[13] = {7,0,1,2,0,3,0,4,2,3,0,3,2};

    // Number of frames
    int frames[3];

    int faults = 0;
    int pointer = 0;

    // Initially frames are empty
    for(int i = 0; i < 3; i++)
    {
        frames[i] = -1;
    }

    printf("Page\tFrames\n");

    // Traverse all pages
    for(int i = 0; i < 13; i++)
    {
        int found = 0;

        // Check page already exists
        for(int j = 0; j < 3; j++)
        {
            if(frames[j] == ref[i])
            {
                found = 1;
                break;
            }
        }

        // If page not found
        if(found == 0)
        {
            // Replace using FIFO
            frames[pointer] = ref[i];

            // Move pointer circularly
            pointer = (pointer + 1) % 3;

            faults++;
        }

        // Display frames
        printf("%d\t", ref[i]);

        for(int j = 0; j < 3; j++)
        {
            if(frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        // Display page fault
        if(found == 0)
            printf("Page Fault");

        printf("\n");
    }

    // Final result
    printf("\nTotal Page Faults = %d\n", faults);

    printf("Hit Ratio = %.2f\n",
           (float)(13 - faults) / 13);

    return 0;
}
